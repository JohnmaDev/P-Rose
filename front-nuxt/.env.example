# PersonalBarber — front-nuxt/.env.local
# Copia este archivo como .env.local para desarrollo local

# PIN de admin — SOLO servidor (NUNCA usar NUXT_PUBLIC_ para secretos)
NUXT_ADMIN_PIN=tu_pin_secreto_aqui

# URL base del sitio (sin trailing slash)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Wompi — Pasarela de Pagos ──────────────────────────
# Llave PÚBLICA (se expone al cliente — es seguro)
# Sandbox: pub_test_XXXX  |  Producción: pub_prod_XXXX
NUXT_PUBLIC_WOMPI_KEY=pub_test_TU_LLAVE_PUBLICA_AQUI

# Ambiente Wompi: 'sandbox' o 'production'
NUXT_PUBLIC_WOMPI_ENV=sandbox

# ── SOLO BACKEND (Netlify Environment Variables) ───────
# ⚠️  NUNCA pongas estos valores aquí — solo para referencia.
# Configúralos directamente en Netlify Dashboard:
# Site Settings → Environment Variables
#
# WOMPI_PUBLIC_KEY=pub_test_XXXX
# WOMPI_PRIVATE_KEY=prv_test_XXXX
# WOMPI_EVENTS_SECRET=test_events_XXXX
# WOMPI_INTEGRITY_KEY=test_integrity_XXXX
# WOMPI_ENVIRONMENT=sandbox
# MONGODB_URI=mongodb+srv://...
